dist/
.DS_Store
*.local
.vite/

# Local secrets. NEVER commit these.
# The variable must NOT be named VITE_* — Vite inlines any VITE_-prefixed env
# var straight into the public client bundle, which would publish the token.
.env
.env.*
!.env.example

# Slide decks compiled from Marp markdown by scripts/build-decks.mjs.
public/decks/

# Working notes, kept on disk and out of the public repo. Students read this
# repository; handoff.md and .claude/ are session scaffolding for whoever is
# maintaining it, and docs/ is the teacher's own planning material.
docs/
handoff.md
.claude/
